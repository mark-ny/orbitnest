# OrbitNest Workspaces: example configuration. Placeholders only. NEVER commit a real .env.
# All variables are optional in development; production requires ORBITNEST_SECRET_KEY.

# development | test | production
ORBITNEST_ENV=development

# Bind address. Keep 127.0.0.1 unless you run behind a TLS reverse proxy.
# Non-loopback binds are refused unless ORBITNEST_ALLOW_NON_LOOPBACK=true AND
# ORBITNEST_SECRET_KEY is set. Put a TLS reverse proxy in front; never expose plain HTTP.
ORBITNEST_HOST=127.0.0.1
ORBITNEST_PORT=8765
# ORBITNEST_ALLOW_NON_LOOPBACK=false

# REQUIRED in production: at least 32 random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ORBITNEST_SECRET_KEY=

# Where data lives. Defaults: Linux ~/.local/share/orbitnest, Windows %LOCALAPPDATA%\OrbitNest,
# Termux ~/.orbitnest
# ORBITNEST_DATA_DIR=
# ORBITNEST_DATABASE_PATH=
# ORBITNEST_LOG_DIR=
ORBITNEST_LOG_LEVEL=INFO

# Public URL when served through a reverse proxy (adds its host to the Host-header allowlist).
# ORBITNEST_PUBLIC_URL=https://nest.example.com
# Extra comma-separated Host names to accept.
# ORBITNEST_ALLOWED_HOSTS=
# Exact origins allowed for cross-origin API use (no wildcards). Same-origin needs none.
# ORBITNEST_CORS_ORIGINS=
# Trust X-Forwarded-* only when a reverse proxy you control sets them.
# ORBITNEST_TRUSTED_PROXY=false
# auto | always | never
# ORBITNEST_COOKIE_SECURE=auto
# ORBITNEST_MAX_REQUEST_BYTES=1048576
# Session lifetime: idle timeout (minutes) and absolute lifetime (hours).
# ORBITNEST_SESSION_IDLE_MINUTES=480
# ORBITNEST_SESSION_ABSOLUTE_HOURS=168

# Uploads and terminals
# ORBITNEST_MAX_UPLOAD_MB=100
# ORBITNEST_MAX_TERMINALS_PER_WORKSPACE=4
# ORBITNEST_MAX_TERMINALS_PER_USER=8
# ORBITNEST_TERMINAL_IDLE_MINUTES=30
# ORBITNEST_TERMINAL_MAX_HOURS=8

# Workspace operations
# ORBITNEST_START_TIMEOUT_SECONDS=60
# ORBITNEST_STOP_GRACE_SECONDS=10
# ORBITNEST_ABANDONED_AFTER_MINUTES=5
# Idle sweeper interval; 0 disables it.
# ORBITNEST_MAINTENANCE_INTERVAL_SECONDS=60
# Streaming limits
# ORBITNEST_MAX_STREAMS_PER_WORKSPACE=2
# ORBITNEST_MAX_STREAMS_PER_USER=4
# ORBITNEST_STREAM_MAX_HOURS=8
